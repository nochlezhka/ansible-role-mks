{% for k, v in mks_compose_environment.items() %}
{{ k }}={{ v }}
{% endfor %}
{% for k, v in env_vars.items() if k not in mks_compose_environment %}
{{ k }}={{ v }}
{% endfor %}
{% if set_logo %}
LOGO_PATH='/uploads/logo.png'
BIG_LOGO_PATH='/uploads/logo_big.png'
{% else %}
LOGO_PATH='/render/logo.png'
BIG_LOGO_PATH='/render/logo_big.png'
{% endif %}

{% for k, v in secret_env_vars.items() if k not in mks_compose_environment %}
{{ k }}='{{ v }}'
{% endfor %}
